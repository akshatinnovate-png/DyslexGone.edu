# ---------------------------------------------------------------------------
# LUMEN OS - every one of these is optional. With no .env at all the whole
# system runs on its offline engine: the graph, the twin, the misconception
# detectors, the labs and the curated animations are all pure computation.
# A hosted model is an UPGRADE (richer prose, animations for topics nobody
# hand-authored), never a dependency.
# ---------------------------------------------------------------------------

# --- model routing ---------------------------------------------------------
# auto (default) | anthropic | groq | openai | deterministic
# 'deterministic' forces the offline engine even if keys are present.
LLM_MODE=auto

# Groq - the default scene author. Fast enough to generate a storyboard inside
# a request, cheap enough to regenerate it when the quality check rejects one.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_DEEP=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=medium
# GROQ_BASE_URL=https://api.groq.com/openai/v1

ANTHROPIC_API_KEY=
# LLM_MODEL_FAST=claude-haiku-4-5-20251001
# LLM_MODEL_BALANCED=claude-sonnet-5-5
# LLM_MODEL_DEEP=claude-opus-5

# Any OpenAI-compatible endpoint: OpenAI, vLLM, Ollama, Together, OpenRouter.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

LLM_CACHE=true
LLM_TIMEOUT_MS=90000
LLM_RETRIES=2
# Hard spend ceiling for the process lifetime, in USD. 0 = unlimited.
LLM_BUDGET_USD=0

# --- animation authoring ---------------------------------------------------
# auto    prefer a hand-tuned builder where one exists, else ask the model
# model   always ask the model (use this to see model output everywhere)
# curated never ask the model
ANIMATION_AUTHOR_MODE=auto
ANIMATION_MAX_BEATS=8
ANIMATION_MAX_RUNTIME_SEC=110
ANIMATION_REPAIR_ATTEMPTS=2

# --- server ----------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
LOG_PRETTY=true

# --- storage ---------------------------------------------------------------
DB_FILE=./data/lumen.sqlite

# --- pedagogy --------------------------------------------------------------
MASTERY_THRESHOLD=0.8
STRUGGLING_THRESHOLD=0.45
COG_LOAD_CEILING=0.78
DEFAULT_GRADE=6

# --- access control (off by default for local development) -----------------
AUTH_ENABLED=false
ROOT_API_KEY=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=600
